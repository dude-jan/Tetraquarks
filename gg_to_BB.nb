       RowBox[{"{", 
        RowBox[{
         RowBox[{"F", "[", 
          RowBox[{"3", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"F", "[", 
           RowBox[{"3", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}]}]}], "}"}]}], ",", 
      RowBox[{"InsertionLevel", "->", 
       RowBox[{"{", "Classes", "}"}]}], ",", 
      RowBox[{"Model", "->", "\"\<SMQCD\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
