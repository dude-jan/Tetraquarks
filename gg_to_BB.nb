  RowBox[{
   RowBox[{"diags", "=", 
    RowBox[{"InsertFields", "[", 
     RowBox[{
      RowBox[{"CreateTopologies", "[", 
       RowBox[{"0", ",", 
        RowBox[{"2", "->", "2"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"{", 
