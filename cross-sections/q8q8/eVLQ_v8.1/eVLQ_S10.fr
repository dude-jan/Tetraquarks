(* ****************************************************************** *)
(* *****                                                        ***** *)
(* *****  FeynRules model file to make the old VLA model exotic ***** *)
(* *****                  SM singlet scalar                     ***** *)
(* *****                                                        ***** *)
(* *****  Author: Benjamin Fuks                                 ***** *)
(* *****                                                        ***** *)
(* ****************************************************************** *)

(* ************************** *)
(* *****      Setup     ***** *)
(* ************************** *)
M$ModelName = "eVLQ_S10";

M$Information = {
  Authors -> {"B. Fuks, T. Flacke, L. Panizzi"}, 
  Version -> "1.7",
  Date -> "20.07.2022"
};

(* 2022.07.20 v1.7 - Fixed coupling order for SVV interactions to be only SWZ *)
(* 2022.03.08 v1.6 - added terms in covariant derivative, modified structure to uniformize with other eVLQ modules *)
(* 2020.01.16 v1.5 - bug fix in the S10-A-Z interaction for scalar S10  *)
(* 2019.11.24 v1.4 - S10-gauge interactions in mass eigenbasis  *)
(* 2019.10.26 v1.31 - S10-VLQ-VLQ interactions added  (T)  *)

FeynmanGauge = False;

M$InteractionOrderHierarchy = { {QCD, 1},  {QED, 2},  {SWZ,2}, {VLQ,2} , {SX,2} , {HDSDS,2}  };
M$InteractionOrderLimit     = { {QCD, 99}, {QED, 99}, {SWZ,2}, {VLQ,99}, {SX,99}, {HDSDS,99} };


(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* S10 couplings to the SM *)
  KS10U == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]}, InteractionOrder -> {SX, 1}, BlockName -> KS10U, Definitions -> {KS10U[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, Value -> {KS10U[1,1] -> 0, KS10U[2,2] -> 0, KS10U[3,3] -> 0}, Description -> "S10 - up quark scalar coupling"},
  KP10U == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]}, InteractionOrder -> {SX, 1}, BlockName -> KP10U, Definitions -> {KP10U[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, Value -> {KP10U[1,1] -> 0, KP10U[2,2] -> 0, KP10U[3,3] -> 0}, Description -> "S10 - up quark pseudoscalar coupling"},
  KS10D == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]}, InteractionOrder -> {SX, 1}, BlockName -> KS10D, Definitions -> {KS10D[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, Value -> {KS10D[1,1] -> 0, KS10D[2,2] -> 0, KS10D[3,3] -> 0}, Description -> "S10 - up quark scalar coupling"},
  KP10D == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]}, InteractionOrder -> {SX, 1}, BlockName -> KP10D, Definitions -> {KP10D[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, Value -> {KP10D[1,1] -> 0, KP10D[2,2] -> 0, KP10D[3,3] -> 0}, Description -> "S10 - up quark pseudoscalar coupling"},
  KS10E == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]}, InteractionOrder -> {SX, 1}, BlockName -> KS10E, Definitions -> {KS10E[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, Value -> {KS10E[1,1] -> 0, KS10E[2,2] -> 0, KS10E[3,3] -> 0}, Description -> "S10 - up quark scalar coupling"},
  KP10E == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]}, InteractionOrder -> {SX, 1}, BlockName -> KP10E, Definitions -> {KP10E[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, Value -> {KP10E[1,1] -> 0, KP10E[2,2] -> 0, KP10E[3,3] -> 0}, Description -> "S10 - up quark pseudoscalar coupling"},
  KS10N == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]}, InteractionOrder -> {SX, 1}, BlockName -> KS10N, Definitions -> {KS10N[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, Value -> {KS10N[1,1] -> 0, KS10N[2,2] -> 0, KS10N[3,3] -> 0}, Description -> "S10 - up quark scalar coupling"},
  KP10N == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]}, InteractionOrder -> {SX, 1}, BlockName -> KP10N, Definitions -> {KP10N[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, Value -> {KP10N[1,1] -> 0, KP10N[2,2] -> 0, KP10N[3,3] -> 0}, Description -> "S10 - up quark pseudoscalar coupling"},

  (* S10 loop-induced couplings to the SM gauge bosons *)
  KS10G  == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-1}}, BlockName -> KS10VV, OrderBlock->1, Value -> 0, Description -> "S10-GG coupling"},
  KS10W  == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KS10VV, OrderBlock->2, Value -> 0, Description -> "S10-WW coupling"},
  KS10ZZ == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KS10VV, OrderBlock->3, Value -> 0, Description -> "S10-ZZ coupling"},
  KS10ZA == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KS10VV, OrderBlock->4, Value -> 0, Description -> "S10-Za coupling"},
  KS10AA == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KS10VV, OrderBlock->5, Value -> 0, Description -> "S10-aa coupling"},
  KP10G  == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-1}}, BlockName -> KP10VV, OrderBlock->1, Value -> 0, Description -> "P10-GG coupling"},
  KP10W  == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KP10VV, OrderBlock->2, Value -> 0, Description -> "P10-WW coupling"},
  KP10ZZ == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KP10VV, OrderBlock->3, Value -> 0, Description -> "P10-ZZ coupling"},
  KP10ZA == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KP10VV, OrderBlock->4, Value -> 0, Description -> "P10-Za coupling"},
  KP10AA == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KP10VV, OrderBlock->5, Value -> 0, Description -> "P10-aa coupling"},

  (* S10 - VLQ - SM interactions *)
  KS10TL == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> KS10TL, Value -> {KS10TL[1] -> 0, KS10TL[2] -> 0, KS10TL[3] -> 0}, Description -> "S10-T-uq coupling (left-handed)"},
  KS10TR == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> KS10TR, Value -> {KS10TR[1] -> 0, KS10TR[2] -> 0, KS10TR[3] -> 0}, Description -> "S10-T-uq coupling (right-handed)"},
  KS10BL == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> KS10BL, Value -> {KS10BL[1] -> 0, KS10BL[2] -> 0, KS10BL[3] -> 0}, Description -> "S10-B-uq coupling (left-handed)"},
  KS10BR == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> KS10BR, Value -> {KS10BR[1] -> 0, KS10BR[2] -> 0, KS10BR[3] -> 0}, Description -> "S10-B-uq coupling (right-handed)"},

 (* S10 - VLQ - VLQ  interactions *)

  KS10TT == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KS10QQ, Value ->  0, Description -> "S10-T-T scalar coupling"},
  KP10TT == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KP10QQ, Value ->  0, Description -> "S10-T-T pseudoscalar coupling"},
  KS10BB == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KS10QQ, Value ->  0, Description -> "S10-B-B scalar coupling"},                                                     
  KP10BB == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KP10QQ, Value ->  0, Description -> "S10-B-B pseudoscalar coupling"},                                               
  KS10XX == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KS10QQ, Value ->  0, Description -> "S10-X-X coupling (scalar coupling)"},                                          
  KP10XX == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KP10QQ, Value ->  0, Description -> "S10-X-X pseudoscalar coupling"},                                               
  KS10YY == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KS10QQ, Value ->  0, Description -> "S10-Y-Y coupling scalar coupling"},                                            
  KP10YY == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KP10QQ, Value ->  0, Description -> "S10-Y-Y pseudoscalar coupling"},

  (* S10 to Higgs couplings *)
  KHS10S10 == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,1}}, BlockName -> KS10H, OrderBlock->1, Value -> 0, Description -> "S10-S10-H coupling"},
  KHHS10   == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,1}}, BlockName -> KS10H, OrderBlock->2, Value -> 0, Description -> "S10-H-H coupling"},
  KHS10Z   == { ParameterType -> External, InteractionOrder -> {SX,1}           , BlockName -> KS10H, OrderBlock->3, Value -> 0, Description -> "S10-H-Z coupling"},

  (* S10 to Higgs couplings *)
  KHDS10DS10 == { ParameterType -> External, InteractionOrder -> {{HDSDS,1}, {QED,-1}}, BlockName -> KHDS10DS10, OrderBlock->1, Value -> 0, Description -> "S10-S10-H derivative coupling"}
};


(* ************************** *)
(* *****   Fields       ***** *)
(* ************************** *)

M$ClassesDescription = {
  (* Neutral scalar singlet *)
  S[100] == { 
    ClassName -> S10,  
    SelfConjugate -> True, 
    Mass -> {MS10,200},  
    Width -> {WS10, 1.1},
    ParticleName -> "s0",
    PDG -> 6100001
  }
};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic and mass terms *)
LS10K := 1/2 DC[S10, mu]^2 - 1/2 MS10^2 S10^2;

(* S10 - SM interactions *)
LS10SM := \
    S10 uqbar[sp1,ff1,cc].uq[sp2,ff2,cc] (KS10U[ff1,ff2]/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] KP10U[ff1,ff2]/2) \
  + S10 dqbar[sp1,ff1,cc].dq[sp2,ff2,cc] (KS10D[ff1,ff2]/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] KP10D[ff1,ff2]/2) \
  + S10 lbar[sp1,ff1].l[sp2,ff2]         (KS10E[ff1,ff2]/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] KP10E[ff1,ff2]/2) \
  + S10 vlbar[sp1,ff1].vl[sp2,ff2]       (KS10N[ff1,ff2]/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] KP10N[ff1,ff2]/2);

(* Interactions with the Higgs *)
LS10H := KHS10S10 vev H S10^2 + KHHS10 vev H^2 S10 + KHS10Z del[S10,mu] Z[mu] H;

(* T interactions *)
LS10T := S10 tpbar[sp1,cc].uq[sp2,ff,cc] (KS10TL[ff] ProjM[sp1,sp2]    + KS10TR[ff] ProjP[sp1,sp2] ) \
       + S10 tpbar[sp1,cc].tp[sp2,cc]    (KS10TT/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] KP10TT/2);

(* B interactions *)
LS10B := S10 bpbar[sp1,cc].dq[sp2,ff,cc] (KS10BL[ff] ProjM[sp1,sp2]    + KS10BR[ff] ProjP[sp1,sp2]) \
       + S10 bpbar[sp1,cc].bp[sp2,cc]    (KS10BB/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] KP10BB/2);

(* X interactions *)
LS10X := S10 xbar[sp1,cc].x[sp2,cc] (KS10XX/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] KP10XX/2);

(* Y interactions *)
LS10Y := S10 ybar[sp1,cc].y[sp2,cc] (KS10YY/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] KP10YY/2);

(* S10 - SM gluons couplings *)
LS10GG := ExpandIndices[\
    KS10G/(16*Pi^2*vev) gs^2 S10 FS[G,mu,nu,a ]^2 \
  + KP10G/(16*Pi^2*vev) gs^2 S10 FS[G,mu, nu,a] Dual[FS][G,mu,nu,a], FlavorExpand->SU2W];

(* S10 - SM EW gauge boson couplings *)
LS10EWVV := ExpandIndices[\
    KS10W/(16*Pi^2*vev)  (2 ee^2/sw^2)        S10 FS[W,mu,nu] FS[Wbar,mu,nu] \
  + KS10ZZ/(16*Pi^2*vev) (ee^2 / (sw^2 cw^2)) S10 FS[Z,mu,nu]^2 \
  + KS10ZA/(16*Pi^2*vev) (2 ee^2 / (sw cw))   S10 FS[Z,mu,nu] FS[A,mu,nu] \
  + KS10AA/(16*Pi^2*vev) (ee^2)               S10 FS[A,mu,nu]^2 \
  + KP10W/(16*Pi^2*vev)  (2 ee^2/sw^2)        S10 FS[W,mu,nu] Dual[FS][Wbar,mu,nu] \
  + KP10ZZ/(16*Pi^2*vev) (ee^2 / (sw^2 cw^2)) S10 FS[Z,mu,nu] Dual[FS][Z,mu,nu] \
  + KP10ZA/(16*Pi^2*vev) (2 ee^2 / (sw cw))   S10 FS[A,mu,nu] Dual[FS][Z,mu,nu] \
  + KP10AA/(16*Pi^2*vev) (ee^2)               S10 FS[A,mu,nu] Dual[FS][A,mu,nu], FlavorExpand->SU2W];

(* Derivative interactions with the Higgs *)
LHDS10DS10 := KHDS10DS10/vev H del[S10, mu]^2;

(* Full LS10 Lagrangian *)
LS10        := LS10K + LS10SM + LS10T + LS10B + LS10X + LS10Y + LS10H + LHDS10DS10 + LS10EWVV + LS10GG + HC[LS10SM + LS10T + LS10B + LS10X + LS10Y];
LS10noWZWGG := LS10K + LS10SM + LS10T + LS10B + LS10X + LS10Y + LS10H + LHDS10DS10 + LS10EWVV          + HC[LS10SM + LS10T + LS10B + LS10X + LS10Y];
LS10no5     := LS10K + LS10SM + LS10T + LS10B + LS10X + LS10Y + LS10H                                  + HC[LS10SM + LS10T + LS10B + LS10X + LS10Y];
