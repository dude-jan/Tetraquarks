Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"S11", " ", "+", " ", "S112"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"replacements", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MW", "->", "80.379"}], ",", 
       RowBox[{"MZ", "->", "91.1876"}], ",", 
       RowBox[{"sw", "->", 
        RowBox[{"Sqrt", "[", "0.2229", "]"}]}], ",", 
       RowBox[{"cw", "->", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "-", "0.2229"}], "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wS11WA", " ", "=", " ", 
     RowBox[{"PartialWidth", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"S11", ",", "W", ",", "A"}], "}"}], ",", "decays"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wS11WZ", " ", "=", " ", 
     RowBox[{"PartialWidth", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"S11", ",", "W", ",", "Z"}], "}"}], ",", "decays"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<{\>\"", ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"InputForm", "[", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["wS11WA", 
          RowBox[{"wS11WA", "+", "wS11WZ"}]], "//", "FullSimplify"}], ")"}], 
       "]"}], "/.", "replacements"}], ",", "\"\<,\>\"", ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"InputForm", "[", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["wS11WZ", 
