(* ****************************************************************** *)
(* *****                                                        ***** *)
(* *****  FeynRules model file to make the old VLA model exotic ***** *)
(* *****                  SM singlet scalar                     ***** *)
(* *****                                                        ***** *)
(* *****  Author: Benjamin Fuks                                 ***** *)
(* *****                                                        ***** *)
(* ****************************************************************** *)

(* ************************** *)
(* *****      Setup     ***** *)
(* ************************** *)
M$ModelName = "eVLQ_S10";

M$Information = {
  Authors -> {"B. Fuks"}, 
  Version -> "1.5",
  Date -> "16.01.2020"
};

(* 2019.10.26 v1.31 - S10-VLQ-VLQ interactions added  (T)  *)
(* 2019.11.24 v1.4 - S10-gauge interactions in mass eigenbasis  *)
(* 2020.01.16 v1.5 - bug fix in the S10-A-Z interaction for scalar S10  *)

FeynmanGauge = False;

M$InteractionOrderHierarchy = { {QCD, 1},  {QED, 2},  {VLQ,2},  {SX,2}  };
M$InteractionOrderLimit     = { {QCD, 99}, {QED, 99}, {VLQ,99}, {SX,99} };

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* S10 couplings to the SM *)
  GS10U == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GS10U, Definitions -> {GS10U[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GS10U[1,1] -> 0.101, GS10U[2,2] -> 0.102, GS10U[3,3] -> 0.103},
    Description -> "S10 - up quark scalar coupling"},
  GP10U == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GP10U, Definitions -> {GP10U[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GP10U[1,1] -> 0.104, GP10U[2,2] -> 0.105, GP10U[3,3] -> 0.106},
    Description -> "S10 - up quark pseudoscalar coupling"},
  GS10D == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GS10D, Definitions -> {GS10D[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GS10D[1,1] -> 0.111, GS10D[2,2] -> 0.112, GS10D[3,3] -> 0.113},
    Description -> "S10 - up quark scalar coupling"},
  GP10D == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GP10D, Definitions -> {GP10D[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GP10D[1,1] -> 0.114, GP10D[2,2] -> 0.115, GP10D[3,3] -> 0.116},
    Description -> "S10 - up quark pseudoscalar coupling"},
  GS10E == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GS10E, Definitions -> {GS10E[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GS10E[1,1] -> 0.121, GS10E[2,2] -> 0.122, GS10E[3,3] -> 0.123},
    Description -> "S10 - up quark scalar coupling"},
  GP10E == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GP10E, Definitions -> {GP10E[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GP10E[1,1] -> 0.124, GP10E[2,2] -> 0.125, GP10E[3,3] -> 0.126},
    Description -> "S10 - up quark pseudoscalar coupling"},
  GS10N == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GS10N, Definitions -> {GS10N[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GS10N[1,1] -> 0.131, GS10N[2,2] -> 0.132, GS10N[3,3] -> 0.133},
    Description -> "S10 - up quark scalar coupling"},
  GP10N == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GP10N, Definitions -> {GP10N[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GP10N[1,1] -> 0.134, GP10N[2,2] -> 0.135, GP10N[3,3] -> 0.136},
    Description -> "S10 - up quark pseudoscalar coupling"},

  (* S10 loop-induced couplings to the SM gauge bosons *)
  KS10G == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS10VV, OrderBlock->1, Value -> 0.141, Description -> "S10-GG coupling"},
  KS10W == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS10VV, OrderBlock->2, Value -> 0.142, Description -> "S10-WW coupling"},
  KS10ZZ == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS10VV, OrderBlock->3, Value -> 0.143, Description -> "S10-ZZ coupling"},
  KS10ZA == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS10VV, OrderBlock->4, Value -> 0.144, Description -> "S10-Za coupling"},
  KS10AA == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS10VV, OrderBlock->5, Value -> 0.145, Description -> "S10-aa coupling"},
  KP10G == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP10VV, OrderBlock->1, Value -> 0.146, Description -> "P10-GG coupling"},
  KP10W == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP10VV, OrderBlock->2, Value -> 0.147, Description -> "P10-WW coupling"},
  KP10ZZ == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP10VV, OrderBlock->3, Value -> 0.148, Description -> "P10-ZZ coupling"},
  KP10ZA == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP10VV, OrderBlock->4, Value -> 0.149, Description -> "P10-Za coupling"},
  KP10AA == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP10VV, OrderBlock->5, Value -> 0.150, Description -> "P10-aa coupling"},

  (* S10 - VLQ - SM interactions *)
  GS10TL == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> GS10TL,
    Value -> {GS10TL[1] -> 0.151, GS10TL[2] -> 0.152, GS10TL[3] -> 0.153},
    Description -> "S10-T-uq coupling (left-handed)"},
  GS10TR == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> GS10TR,
    Value -> {GS10TR[1] -> 0.154, GS10TR[2] -> 0.155, GS10TR[3] -> 0.156},
    Description -> "S10-T-uq coupling (right-handed)"},
  GS10BL == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> GS10BL,
    Value -> {GS10BL[1] -> 0.161, GS10BL[2] -> 0.162, GS10BL[3] -> 0.163},
    Description -> "S10-B-uq coupling (left-handed)"},
  GS10BR == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> GS10BR,
    Value -> {GS10BR[1] -> 0.164, GS10BR[2] -> 0.165, GS10BR[3] -> 0.166},
    Description -> "S10-B-uq coupling (right-handed)"},

 (* S10 - VLQ - VLQ  interactions *)

  GS10TT == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GS10TT, 
    Value ->  0.153, Description -> "S10-T-T scalar coupling"},
  GP10TT == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GP10TT, 
    Value ->  0.153, Description -> "S10-T-T pseudoscalar coupling"},
  GS10BB == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GS10BB, 
    Value ->  0.154, Description -> "S10-B-B scalar coupling"},
  GP10BB == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GP10BB, 
    Value ->  0.154, Description -> "S10-B-B pseudoscalar coupling"},
  GS10XX == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GS10XX, 
    Value ->  0.155, Description -> "S10-X-X coupling (scalar coupling)"},
  GP10XX == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GP10XX, 
    Value ->  0.155, Description -> "S10-X-X pseudoscalar coupling"},
  GS10YY == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GS10YY, 
    Value ->  0.156, Description -> "S10-Y-Y coupling scalar coupling"},
  GP10YY == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GP10YY, 
    Value ->  0.156, Description -> "S10-Y-Y pseudoscalar coupling"},


  (* S10 to Higgs couplings *)
  KS10H1 == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS10H, OrderBlock->1, Value -> 0.171, Description -> "S10-S10-H coupling"},
  KS10H2 == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,1}}, BlockName -> KS10H, OrderBlock->2, Value -> 0.172, Description -> "S10-S10-H coupling"},
  KS10HH == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,1}}, BlockName -> KS10H, OrderBlock->3, Value -> 0.173, Description -> "S10-H-H coupling"},
  KS10HZ == { ParameterType -> External, InteractionOrder -> {SX,1}, BlockName -> KS10H, OrderBlock->4, Value -> 0.174, Description -> "S10-H-Z coupling"}
};


(* ************************** *)
(* *****   Fields       ***** *)
(* ************************** *)

M$ClassesDescription = {
  (* Neutral scalar singlet *)
  S[100] == { ClassName -> S10,  SelfConjugate -> True, Mass -> {MS10,500.1},  Width -> {WS10, 1.1}, PDG -> 6100001}
};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic and mass terms *)
LS10K := 1/2 del[S10,mu]^2 - 1/2 MS10^2 S10^2;

(* S10 - SM interactions *)
LS10SM := \
    S10 uqbar[sp1,ff1,cc].uq[sp2,ff2,cc] (GS10U[ff1,ff2] IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP10U[ff1,ff2]) \
  + S10 dqbar[sp1,ff1,cc].dq[sp2,ff2,cc] (GS10D[ff1,ff2] IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP10D[ff1,ff2]) \
  + S10 lbar[sp1,ff1].l[sp2,ff2]         (GS10E[ff1,ff2] IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP10E[ff1,ff2]) \
  + S10 vlbar[sp1,ff1].vl[sp2,ff2]       (GS10N[ff1,ff2] IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP10N[ff1,ff2]);

(* S10 - SM gauge boson couplings *)
LS10VV := ExpandIndices[\
    KS10G/(16*Pi^2*vev) gs^2 S10 FS[G,mu,nu,a ]^2 \
  + KS10W/(16*Pi^2*vev) gw^2 S10 FS[W,mu,nu] FS[Wbar,mu,nu] \
  + KS10ZZ/(16*Pi^2*vev) (ee^2 / (sw^2 cw^2)) S10 FS[Z,mu,nu]^2 \
  + KS10ZA/(16*Pi^2*vev) (2 ee^2 / (sw cw)) S10 FS[Z,mu,nu] FS[A,mu,nu] \
  + KS10AA/(16*Pi^2*vev) ee^2 S10 FS[A,mu,nu]^2 \
  + KP10G/(16*Pi^2*vev) gs^2 S10 FS[G,mu, nu,a] Dual[FS][G,mu,nu,a] \
  + KP10W/(16*Pi^2*vev) gw^2 S10 FS[W,mu,nu] Dual[FS][Wbar,mu,nu] \
  + KP10ZZ/(16*Pi^2*vev) (ee^2 / (sw^2 cw^2)) S10 FS[Z,mu,nu] Dual[FS][Z,mu,nu] \
  + KP10ZA/(16*Pi^2*vev) (2 ee^2 / (sw cw)) S10 FS[A,mu,nu] Dual[FS][Z,mu,nu] \
  + KP10AA/(16*Pi^2*vev) ee^2 S10 FS[A,mu,nu] Dual[FS][A,mu,nu], FlavorExpand->SU2W];


(* Interactions with the Higgs *)
LS10H := KS10H1/vev H del[S10,mu]^2 + KS10H2 vev H S10^2 + KS10HH vev H^2 S10 + KS10HZ del[S10,mu] Z[mu] H;
LS10Hno5 := KS10H2 vev H S10^2 + KS10HH vev H^2 S10;


(* T interactions *)
LS10T := S10 tpbar[sp1,cc].uq[sp2,ff,cc] (ProjM[sp1,sp2] GS10TL[ff] + ProjP[sp1,sp2] GS10TR[ff]) \
       + S10 tpbar[sp1,cc].tp[sp2,cc] (GS10TT /2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP10TT /2);

(* B interactions *)
LS10B := S10 bpbar[sp1,cc].dq[sp2,ff,cc] (ProjM[sp1,sp2] GS10BL[ff] + ProjP[sp1,sp2] GS10BR[ff]) \
       + S10 bpbar[sp1,cc].bp[sp2,cc] (GS10BB/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP10BB/2);

(* X interactions *)
LS10X := S10 xbar[sp1,cc].x[sp2,cc] (GS10XX/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP10XX/2);

(* Y interactions *)
LS10Y := S10 ybar[sp1,cc].y[sp2,cc] (GS10YY/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP10YY/2);


(* Full LS10 Lagrangian *)
LS10 := LS10K + LS10SM + LS10VV + LS10T + LS10B + LS10X + LS10Y + LS10H + HC[LS10SM + LS10T + LS10B + LS10X + LS10Y];
LS10no5 := LS10K + LS10SM + LS10T + LS10B + LS10X + LS10Y + LS10Hno5 + HC[LS10SM + LS10T + LS10B + LS10X + LS10Y];
