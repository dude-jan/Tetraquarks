(* ****************************************************************** *)
(* *****                                                        ***** *)
(* *****  FeynRules model file to make the old VLA model exotic ***** *)
(* *****                  SM singlet scalar                     ***** *)
(* *****                                                        ***** *)
(* *****  Author: Benjamin Fuks                                 ***** *)
(* *****                                                        ***** *)
(* ****************************************************************** *)

(* ************************** *)
(* *****      Setup     ***** *)
(* ************************** *)
M$ModelName = "eVLQ_S102";

M$Information = {
  Authors -> {"B. Fuks"}, 
  Version -> "1.5",
  Date -> "16.01.2020"
};

(* 2019.10.26 v1.31 - S102-VLQ-VLQ interactions added  (T)  *)
(* 2019.11.24 v1.4 - S102-gauge interactions in mass eigenbasis  *)
(* 2020.01.16 v1.5 - bug fix in the S102-A-Z interaction for scalar S102  *)

FeynmanGauge = False;

M$InteractionOrderHierarchy = { {QCD, 1},  {QED, 2},  {VLQ,2},  {SX,2}  };
M$InteractionOrderLimit     = { {QCD, 99}, {QED, 99}, {VLQ,99}, {SX,99} };

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* S102 couplings to the SM *)
  GS102U == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GS102U, Definitions -> {GS102U[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GS102U[1,1] -> 0.101, GS102U[2,2] -> 0.102, GS102U[3,3] -> 0.103},
    Description -> "S102 - up quark scalar coupling"},
  GP102U == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GP102U, Definitions -> {GP102U[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GP102U[1,1] -> 0.104, GP102U[2,2] -> 0.105, GP102U[3,3] -> 0.106},
    Description -> "S102 - up quark pseudoscalar coupling"},
  GS102D == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GS102D, Definitions -> {GS102D[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GS102D[1,1] -> 0.111, GS102D[2,2] -> 0.112, GS102D[3,3] -> 0.113},
    Description -> "S102 - up quark scalar coupling"},
  GP102D == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GP102D, Definitions -> {GP102D[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GP102D[1,1] -> 0.114, GP102D[2,2] -> 0.115, GP102D[3,3] -> 0.116},
    Description -> "S102 - up quark pseudoscalar coupling"},
  GS102E == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GS102E, Definitions -> {GS102E[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GS102E[1,1] -> 0.121, GS102E[2,2] -> 0.122, GS102E[3,3] -> 0.123},
    Description -> "S102 - up quark scalar coupling"},
  GP102E == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GP102E, Definitions -> {GP102E[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GP102E[1,1] -> 0.124, GP102E[2,2] -> 0.125, GP102E[3,3] -> 0.126},
    Description -> "S102 - up quark pseudoscalar coupling"},
  GS102N == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GS102N, Definitions -> {GS102N[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GS102N[1,1] -> 0.131, GS102N[2,2] -> 0.132, GS102N[3,3] -> 0.133},
    Description -> "S102 - up quark scalar coupling"},
  GP102N == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation], Index[Generation]},
    InteractionOrder -> {SX, 1}, BlockName -> GP102N, Definitions -> {GP102N[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value -> {GP102N[1,1] -> 0.134, GP102N[2,2] -> 0.135, GP102N[3,3] -> 0.136},
    Description -> "S102 - up quark pseudoscalar coupling"},

  (* S102 loop-induced couplings to the SM gauge bosons *)
  KS102G == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS102VV, OrderBlock->1, Value -> 0.141, Description -> "S102-GG coupling"},
  KS102W == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS102VV, OrderBlock->2, Value -> 0.142, Description -> "S102-WW coupling"},
  KS102ZZ == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS102VV, OrderBlock->3, Value -> 0.143, Description -> "S102-ZZ coupling"},
  KS102ZA == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS102VV, OrderBlock->4, Value -> 0.144, Description -> "S102-Za coupling"},
  KS102AA == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS102VV, OrderBlock->5, Value -> 0.145, Description -> "S102-aa coupling"},
  KP102G == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP102VV, OrderBlock->1, Value -> 0.146, Description -> "P102-GG coupling"},
  KP102W == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP102VV, OrderBlock->2, Value -> 0.147, Description -> "P102-WW coupling"},
  KP102ZZ == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP102VV, OrderBlock->3, Value -> 0.148, Description -> "P102-ZZ coupling"},
  KP102ZA == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP102VV, OrderBlock->4, Value -> 0.149, Description -> "P102-Za coupling"},
  KP102AA == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KP102VV, OrderBlock->5, Value -> 0.150, Description -> "P102-aa coupling"},

  (* S102 - VLQ - SM interactions *)
  GS102TL == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> GS102TL,
    Value -> {GS102TL[1] -> 0.151, GS102TL[2] -> 0.152, GS102TL[3] -> 0.153},
    Description -> "S102-T-uq coupling (left-handed)"},
  GS102TR == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> GS102TR,
    Value -> {GS102TR[1] -> 0.154, GS102TR[2] -> 0.155, GS102TR[3] -> 0.156},
    Description -> "S102-T-uq coupling (right-handed)"},
  GS102BL == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> GS102BL,
    Value -> {GS102BL[1] -> 0.161, GS102BL[2] -> 0.162, GS102BL[3] -> 0.163},
    Description -> "S102-B-uq coupling (left-handed)"},
  GS102BR == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> GS102BR,
    Value -> {GS102BR[1] -> 0.164, GS102BR[2] -> 0.165, GS102BR[3] -> 0.166},
    Description -> "S102-B-uq coupling (right-handed)"},

 (* S102 - VLQ - VLQ  interactions *)

  GS102TT == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GS102TT, 
    Value ->  0.153, Description -> "S102-T-T scalar coupling"},
  GP102TT == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GP102TT, 
    Value ->  0.153, Description -> "S102-T-T pseudoscalar coupling"},
  GS102BB == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GS102BB, 
    Value ->  0.154, Description -> "S102-B-B scalar coupling"},
  GP102BB == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GP102BB, 
    Value ->  0.154, Description -> "S102-B-B pseudoscalar coupling"},
  GS102XX == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GS102XX, 
    Value ->  0.155, Description -> "S102-X-X coupling (scalar coupling)"},
  GP102XX == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GP102XX, 
    Value ->  0.155, Description -> "S102-X-X pseudoscalar coupling"},
  GS102YY == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GS102YY, 
    Value ->  0.156, Description -> "S102-Y-Y coupling scalar coupling"},
  GP102YY == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> GP102YY, 
    Value ->  0.156, Description -> "S102-Y-Y pseudoscalar coupling"},


  (* S102 to Higgs couplings *)
  KS102H1 == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS102H, OrderBlock->1, Value -> 0.171, Description -> "S102-S102-H coupling"},
  KS102H2 == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,1}}, BlockName -> KS102H, OrderBlock->2, Value -> 0.172, Description -> "S102-S102-H coupling"},
  KS102HH == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,1}}, BlockName -> KS102H, OrderBlock->3, Value -> 0.173, Description -> "S102-H-H coupling"},
  KS102HZ == { ParameterType -> External, InteractionOrder -> {SX,1}, BlockName -> KS102H, OrderBlock->4, Value -> 0.174, Description -> "S102-H-Z coupling"}
};


(* ************************** *)
(* *****   Fields       ***** *)
(* ************************** *)

M$ClassesDescription = {
  (* Neutral scalar singlet *)
  S[1002] == { ClassName -> S102,  SelfConjugate -> True, Mass -> {MS102,510},  Width -> {WS102, 1.1}, PDG -> 6102001}
};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic and mass terms *)
LS102K := 1/2 del[S102,mu]^2 - 1/2 MS102^2 S102^2;

(* S102 - SM interactions *)
LS102SM := \
    S102 uqbar[sp1,ff1,cc].uq[sp2,ff2,cc] (GS102U[ff1,ff2] IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP102U[ff1,ff2]) \
  + S102 dqbar[sp1,ff1,cc].dq[sp2,ff2,cc] (GS102D[ff1,ff2] IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP102D[ff1,ff2]) \
  + S102 lbar[sp1,ff1].l[sp2,ff2]         (GS102E[ff1,ff2] IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP102E[ff1,ff2]) \
  + S102 vlbar[sp1,ff1].vl[sp2,ff2]       (GS102N[ff1,ff2] IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP102N[ff1,ff2]);

(* S102 - SM gauge boson couplings *)
LS102VV := ExpandIndices[\
    KS102G/(16*Pi^2*vev) gs^2 S102 FS[G,mu,nu,a ]^2 \
  + KS102W/(16*Pi^2*vev) gw^2 S102 FS[W,mu,nu] FS[Wbar,mu,nu] \
  + KS102ZZ/(16*Pi^2*vev) (ee^2 / (sw^2 cw^2)) S102 FS[Z,mu,nu]^2 \
  + KS102ZA/(16*Pi^2*vev) (2 ee^2 / (sw cw)) S102 FS[Z,mu,nu] FS[A,mu,nu] \
  + KS102AA/(16*Pi^2*vev) ee^2 S102 FS[A,mu,nu]^2 \
  + KP102G/(16*Pi^2*vev) gs^2 S102 FS[G,mu, nu,a] Dual[FS][G,mu,nu,a] \
  + KP102W/(16*Pi^2*vev) gw^2 S102 FS[W,mu,nu] Dual[FS][Wbar,mu,nu] \
  + KP102ZZ/(16*Pi^2*vev) (ee^2 / (sw^2 cw^2)) S102 FS[Z,mu,nu] Dual[FS][Z,mu,nu] \
  + KP102ZA/(16*Pi^2*vev) (2 ee^2 / (sw cw)) S102 FS[A,mu,nu] Dual[FS][Z,mu,nu] \
  + KP102AA/(16*Pi^2*vev) ee^2 S102 FS[A,mu,nu] Dual[FS][A,mu,nu], FlavorExpand->SU2W];


(* Interactions with the Higgs *)
LS102H := KS102H1/vev H del[S102,mu]^2 + KS102H2 vev H S102^2 + KS102HH vev H^2 S102 + KS102HZ del[S102,mu] Z[mu] H;
LS102Hno5 := KS102H2 vev H S102^2 + KS102HH vev H^2 S102;


(* T interactions *)
LS102T := S102 tpbar[sp1,cc].uq[sp2,ff,cc] (ProjM[sp1,sp2] GS102TL[ff] + ProjP[sp1,sp2] GS102TR[ff]) \
       + S102 tpbar[sp1,cc].tp[sp2,cc] (GS102TT /2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP102TT /2);

(* B interactions *)
LS102B := S102 bpbar[sp1,cc].dq[sp2,ff,cc] (ProjM[sp1,sp2] GS102BL[ff] + ProjP[sp1,sp2] GS102BR[ff]) \
       + S102 bpbar[sp1,cc].bp[sp2,cc] (GS102BB/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP102BB/2);

(* X interactions *)
LS102X := S102 xbar[sp1,cc].x[sp2,cc] (GS102XX/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP102XX/2);

(* Y interactions *)
LS102Y := S102 ybar[sp1,cc].y[sp2,cc] (GS102YY/2 IndexDelta[sp1,sp2] + I Ga[5,sp1,sp2] GP102YY/2);


(* Full LS102 Lagrangian *)
LS102 := LS102K + LS102SM + LS102VV + LS102T + LS102B + LS102X + LS102Y + LS102H + HC[LS102SM + LS102T + LS102B + LS102X + LS102Y];
LS102no5 := LS102K + LS102SM + LS102T + LS102B + LS102X + LS102Y + LS102Hno5 + HC[LS102SM + LS102T + LS102B + LS102X + LS102Y];
