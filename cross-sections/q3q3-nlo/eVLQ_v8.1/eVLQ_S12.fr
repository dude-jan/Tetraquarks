(***************************************************************************************************************)
(******                       FeynRules mod-file for color singlet scalars                                ******)
(******                                        S12 (Q=2)                                                  ******)
(******                                                                                                   ******)
(******     Authors: M. Kunkel                                                                            ******)
(******     Compatibility with the new SM.fr of FR 2.0 and VLQ_v4.fr                                      ******)
(***************************************************************************************************************)

M$ModelName = "eVLQ_S12";

M$Information = {
  Authors -> {"M. Kunkel", "L. Panizzi"}, 
  Version -> "1.4",
  Date -> "20.07.2022"
};

(* 2022.07.20 v1.4 - Fixed coupling order for SVV interactions to be only SWZ *)
(* 2022.03.08 v1.3 - Redefinition of block names *)
(* 2022.03.01 v1.2 - Order hierarchy for VLQ set to 2 *)
(* 2021.03.11 v1.1 - Fixed bug in LS12VLQSM1 *)


FeynmanGauge =False;

M$InteractionOrderHierarchy = { {QCD, 1},  {QED, 2},  {VLQ,2},  {SWZ,2}, {SX,2}  };
M$InteractionOrderLimit     = { {QCD, 99}, {QED, 99}, {VLQ,99}, {SWZ,2}, {SX,99} };

(* ************************** *)
(* *****   Fields       ***** *)
(* ************************** *)

M$ClassesDescription = {
  (* Color octet scalar S12 (Q=2) *)

    S[102] == { 
        ClassName -> S12,  
        SelfConjugate -> False, 
        Indices -> {},
        Mass -> {MS12, 500.5},  
        Width -> {WS12, 1.1}, 
        QuantumNumbers -> {Q -> 2},
        PropagatorLabel -> "S12",
        PropagatorType -> ScalarDash,
        ParticleName -> "s++", 
        AntiParticleName -> "s--", 
        PDG -> 6100003,
        FullName -> "S12-scalar"
    }
};



(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {


  (*S12 couplings to two VLQs*)
  KS12XBL == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KS12QQ, OrderBlock->1, Value ->  0, Description -> "S12-X-B scalar coupling (left-handed)"},
  KS12XBR == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KS12QQ, OrderBlock->2, Value ->  0, Description -> "S12-X-B scalar coupling (right-handed)"},
  KS12YTL == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KS12QQ, OrderBlock->3, Value ->  0, Description -> "S12-Y-T scalar coupling (left-handed)"},
  KS12YTR == { ParameterType -> External, ComplexParameter -> False,  InteractionOrder -> {VLQ, 1}, BlockName -> KS12QQ, OrderBlock->4, Value ->  0, Description -> "S12-Y-T scalar coupling (right-handed)"},


  (*S12 couplings to one SM quark and one VLQ*)
  KS12XDL == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> KS12XDL, Value -> {KS12XDL[1] -> 0, KS12XDL[2] -> 0, KS12XDL[3] -> 0}, Description -> "S12-X-dq coupling (left-handed)"},
  KS12XDR == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> KS12XDR, Value -> {KS12XDR[1] -> 0, KS12XDR[2] -> 0, KS12XDR[3] -> 0}, Description -> "S12-X-dq coupling (right-handed)"},
  KS12YUL == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> KS12YUL, Value -> {KS12YUL[1] -> 0, KS12YUL[2] -> 0, KS12YUL[3] -> 0}, Description -> "S12-Y-uq coupling (left-handed)"},
  KS12YUR == { ParameterType -> External, ComplexParameter -> False, Indices->{Index[Generation]}, InteractionOrder -> {VLQ, 1}, BlockName -> KS12YUR, Value -> {KS12YUR[1] -> 0, KS12YUR[2] -> 0, KS12YUR[3] -> 0}, Description -> "S12-Y-uq coupling (right-handed)"},

  (*S12 couplings to two vector bosons*)
  KS12W == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KS12WW, OrderBlock->1, Value -> 0, Description -> "S12-WW coupling"},
  KP12W == { ParameterType -> External, InteractionOrder -> {{SWZ,1}, {QED,-3}}, BlockName -> KS12WW, OrderBlock->2, Value -> 0, Description -> "P12-WW coupling"},

  (*S12 couplings to the Higgs*)
  KS12H1 == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,-1}}, BlockName -> KS12H, OrderBlock->1, Value -> 0, Description -> "S12-S12-H coupling"},
  KS12H2 == { ParameterType -> External, InteractionOrder -> {{SX,1}, {QED,1}},  BlockName -> KS12H, OrderBlock->2, Value -> 0, Description -> "S12-S12-H coupling"},
  KS12HH == { ParameterType -> External, InteractionOrder -> {SX,1},             BlockName -> KS12H, OrderBlock->3, Value -> 0, Description -> "S12-S12-H-H coupling"}

}


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic and mass terms *)
LS12K := (DC[S12bar, mu] + 2 I ee A[mu] S12bar) (DC[S12, mu] - 2 I ee A[mu] S12) - MS12^2 S12bar S12;

(*S12 - VLQ interactions*)
LS12VLQ1 :=   xbar[sp1,cc1].bp[sp2,cc1] (ProjM[sp1,sp2] KS12XBL + ProjP[sp1,sp2] KS12XBR) S12 \
            + ybar[sp1,cc1].tp[sp2,cc1] (ProjM[sp1,sp2] KS12YTL + ProjP[sp1,sp2] KS12YTR) S12bar;
LS12VLQ := LS12VLQ1 + HC[LS12VLQ1];

(*S12 - VLQ - SM interactions*)
LS12VLQSM1 := xbar[sp1,cc1].dq[sp2,ff,cc1] (ProjM[sp1,sp2] KS12XDL[ff] + ProjP[sp1,sp2] KS12XDR[ff]) S12 \
            + ybar[sp1,cc1].uq[sp2,ff,cc1] (ProjM[sp1,sp2] KS12YUL[ff] + ProjP[sp1,sp2] KS12YUR[ff]) S12bar;
LS12VLQSM := LS12VLQSM1 + HC[LS12VLQSM1];

(*S12 - Vector boson interactions*)
LS12VV1 := ExpandIndices[\
          KS12W gw^2/(16 Pi^2 vev) S12 FS[Wbar, mu, nu] FS[Wbar, mu, nu] \
        + KP12W gw^2/(16 Pi^2 vev) S12 FS[Wbar, mu, nu] Dual[FS][Wbar, mu, nu], FlavorExpand -> SU2W]; 
LS12VV = LS12VV1 + HC[LS12VV1];
      
(*S12 - Higgs interactions*)
LS12H := KS12H1/vev H (DC[S12bar, mu] + 2 I ee A[mu] S12bar) (DC[S12, mu] - 2 I ee A[mu] S12) + KS12H2 vev H S12bar S12 + KS12HH H^2 S12bar S12;
LS12Hno5 := KS12H2 vev H S12bar S12 + KS12HH H^2 S12bar S12;

(*Lagrangian for S12*)
LS12 := LS12K + LS12VLQ + LS12VLQSM + LS12VV + LS12H;
LS12no5 := LS12K + LS12VLQ + LS12VLQSM + LS12Hno5;
