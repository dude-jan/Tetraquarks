Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"amp", "[", "0", "]"}], "=", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{
     RowBox[{"CreateFeynAmp", "[", "diags", "]"}], ",", 
     RowBox[{"IncomingMomenta", "->", 
      RowBox[{"{", 
