 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"amp", "[", "0", "]"}], "=", 
    RowBox[{"FCFAConvert", "[", 
     RowBox[{
      RowBox[{"CreateFeynAmp", "[", "diags", "]"}], ",", 
      RowBox[{"IncomingMomenta", "->", 
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
      RowBox[{"OutgoingMomenta", "->", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2"}], "}"}]}], ",", 
      RowBox[{"UndoChiralSplittings", "->", "True"}], ",", 
      RowBox[{"ChangeDimension", "->", "D"}], ",", 
      RowBox[{"TransversePolarizationVectors", "->", 
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
      RowBox[{"List", "->", "True"}], ",", 
      RowBox[{"SMP", "->", "True"}], ",", 
      RowBox[{"Contract", "->", "True"}], ",", 
      RowBox[{"DropSumOver", "->", "True"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{"s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", 
    RowBox[{"-", "q1"}], ",", 
    RowBox[{"-", "q2"}], ",", "0", ",", "0", ",", 
    RowBox[{"SMP", "[", "\"\<m_u\>\"", "]"}], ",", 
    RowBox[{"SMP", "[", "\"\<m_u\>\"", "]"}]}], "]"}], ";"}]}], "Input",
