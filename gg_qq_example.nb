        RowBox[{"SMP", "[", "\"\<g_s\>\"", "]"}], "^", "4"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"t", "^", "2"}], "+", 
          RowBox[{"u", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"t", " ", "u"}], ")"}]}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", "/", "8"}], ")"}], " ", 
       RowBox[{
        RowBox[{"SMP", "[", "\"\<g_s\>\"", "]"}], "^", "4"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"t", "^", "2"}], "+", 
          RowBox[{"u", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"s", "^", "2"}], ")"}]}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FCCompareResults", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ampSquaredMasslessSUNN3", "[", "0", "]"}], "}"}], ",", 
    RowBox[{"{", "knownResults", "}"}], ",", 
    RowBox[{"Factoring", "->", 
     RowBox[{"Function", "[", 
      RowBox[{"x", ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{"TrickMandelstam", "[", 
         RowBox[{"x", ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], 
        "]"}]}], "]"}]}]}], "]"}], ";"}]}], "Input",
